# Root .dockerignore — Render builds with the repo root as context.
# Exclude everything the backend image must not contain.

# Backend junk
backend/.venv/
backend/.env
backend/.env.*
!backend/.env.example
backend/db.sqlite3
backend/db.sqlite3-journal
backend/media/
backend/staticfiles/
backend/__pycache__/
backend/**/__pycache__/
backend/.pytest_cache/
backend/.ruff_cache/
backend/tests/

# The Dockerfile itself and deploy docs don't need to be in the image
backend/Dockerfile
backend/.dockerignore
backend/docker-compose*.yml

# Frontend is not part of the backend image
frontend/
draft.css
draft.html
draft.js

# Git / tooling
.git
.gitignore
.gitattributes
.commandcode/
.vscode/
*.md
