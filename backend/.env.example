# ------------------------------------------------------------------ #
# Copy to `.env` for local prod-like runs. In dev (config.settings.dev)
# almost nothing here is required — SQLite + local storage are defaults.
# In production (config.settings.prod) every uncommented var is required.
# ------------------------------------------------------------------ #

# Which settings module to load (dev | prod)
DJANGO_SETTINGS_MODULE=config.settings.prod

# First admin bootstrap (set these, then run `python manage.py ensure_admin`).
# There is no auto-seeded demo admin — the operator provides these.
ADMIN_EMAIL=your-admin@example.com
ADMIN_PASSWORD=change-me-strong-password
ADMIN_FULL_NAME=Site Admin

# Sender address for transactional email (password-reset codes) — the same
# public contact mailbox used in the site footer.
DEFAULT_FROM_EMAIL=Darb <Darbconttactt@gmail.com>

# Email (SMTP) — used for password-reset codes. Leave EMAIL_BACKEND unset to
# keep the console backend (codes print to the server log); set the rest to
# send real mail from Darbconttactt@gmail.com (e.g. Gmail app password:
# EMAIL_HOST=smtp.gmail.com, EMAIL_PORT=587, EMAIL_HOST_USER=Darbconttactt@gmail.com,
# EMAIL_USE_TLS=True).
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=Darbconttactt@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
EMAIL_USE_TLS=True

# Core
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com
# Include local/LAN dev origins (e.g. http://192.168.68.114:5500) here when testing from a phone.
CSRF_TRUSTED_ORIGINS=https://your-domain.com,http://localhost:5500,http://127.0.0.1:5500
DJANGO_TIME_ZONE=UTC

# Database (prod) — django-environ DATABASE_URL form
DATABASE_URL=postgres://karkh:karkh@db:5432/karkh
# Used by the bundled postgres service in docker-compose.yml
POSTGRES_DB=karkh
POSTGRES_USER=karkh
POSTGRES_PASSWORD=karkh

# Cache / Redis (prod required; dev optional)
REDIS_URL=redis://redis:6379/0

# JWT
JWT_SECRET=change-me-too
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7
JWT_ISSUER=karkh-backend

# Object storage — MinIO (prod). The bundled minio service uses these too.
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET_NAME=karkh-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_QUERYSTRING_AUTH=True
S3_URL_PROTOCOL=http:

# CORS — the Next.js frontend origin(s)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Gunicorn
GUNICORN_WORKERS=3
